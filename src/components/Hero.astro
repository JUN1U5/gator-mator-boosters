---
import bgImg from '../assets/GLHS_Dance_2026-teal.jpg';
---
<!-- 💡 THE STRUCTURAL FIX: Wrap everything inside a scrolling viewport boundary track -->
<div class="hero-track">
  <section class="hero-section">
    <!-- Background Image Layer -->
    <div 
      id="hero-bg" 
      class="hero-bg"
      style={`background-image: url(${bgImg.src});`}
    >
      <div id="hero-overlay" class="dark-overlay"></div>
    </div>

    <!-- Hero Content (Stays completely fixed in space while the overlay darkens) -->
    <div class="hero-content">
      <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl">
        To the Stars and Beyond
      </h1>
      <p class="mt-6 max-w-xl text-lg text-zinc-300 sm:text-xl">
        A beautiful parallax fade effect built directly inside an Astro component.
      </p>
      <button class="mt-10 rounded-full bg-white px-6 py-3 font-semibold text-black transition hover:bg-zinc-200">
        Explore Universe
      </button>
    </div>
  </section>
</div>

<script>
  const initParallax = () => {
    const bg = document.getElementById('hero-bg');
    const overlay = document.getElementById('hero-overlay');
    
    if (!bg || !overlay) return;

    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      const viewHeight = window.innerHeight;
      
      // Stop checking calculations when completely out of the viewport window
      if (scrollY > viewHeight) return;

      // 1. Subtle Background-Only Parallax 
      const bgTranslate = scrollY * 0.25;
      bg.style.transform = `translateY(${bgTranslate}px)`;

      // 2. Accelerated Background-Only Fade-to-Black Logic
      // Ramps up from 0.5 to 1.0 within the first 45% of the viewport scroll
      const fadeProgress = Math.min(1, scrollY / (viewHeight * 0.45));
      const targetOpacity = 0.5 + (fadeProgress * 0.5);
      overlay.style.backgroundColor = `rgba(0, 0, 0, ${targetOpacity})`;
      
    }, { passive: true });
  };

  initParallax();
  document.addEventListener('astro:after-swap', initParallax);
</script>

<style>
/* 💡 Ensures the track creates natural scrolling space for the viewport */
.hero-track {
  height: 100vh;
  position: relative;
}

/* 💡 The Hero is locked to the top. It does not scroll up; it stays perfectly frozen. */
.hero-section {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  background-color: #000000;
  z-index: 1; /* Sits completely behind incoming sections */
}

#hero-bg {
  position: absolute;
  top: 0px;
  right: 0px;
  bottom: 0px;
  left: 0px;
  background-size: cover;
  background-position: center;
  will-change: transform;
  z-index: 2;
}

.dark-overlay {
  position: absolute;
  top: 0px;
  right: 0px;
  bottom: 0px;
  left: 0px;
  background-color: rgba(0, 0, 0, 0.5);
  will-change: background-color;
  z-index: 3;
}

.hero-content {
  position: relative;
  z-index: 4;
  display: flex;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 1rem;
  padding-right: 1rem;
  text-align: center;
  color: #fff;
}
</style>