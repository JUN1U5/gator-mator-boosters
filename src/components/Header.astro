---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, headerActions } from '../data/navitgation';
import { url, currentPath } from '../url';

const path = currentPath(Astro.url.pathname);

/**
 * `page` for the exact current page, `true` for a parent section (e.g. Blog
 * while reading a post). Home-page anchors are never marked as current.
 */
function current(href: string): 'page' | 'true' | undefined {
  if (href.includes('#')) return undefined;
  if (href === path) return 'page';
  if (href !== '/' && path.startsWith(`${href}/`)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="container">
    <Logo />
    <nav class="nav" id="primary-nav" aria-label="Primary">
      {primaryNav.map((item) => (
        <a href={url(item.href)} aria-current={current(item.href)}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      {headerActions.schedule && (
        <a class="btn btn--glass" href={url(headerActions.schedule.href)} aria-label={headerActions.schedule.ariaLabel}>
          
        </a>
      )}
      {headerActions.memberships && (
        <a class="icon-btn btn--glass" href={url(headerActions.memberships.href)} aria-label={headerActions.memberships.ariaLabel}>
         
        </a>
      )}
      <MobileMenu />
    </div>
  </div>
</header>
