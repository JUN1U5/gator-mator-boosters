---
import '../assets/styles.css';

// HeroVideo.astro
interface Props {
  videoSrc: string;
  posterImage?: string;
  title?: string;
  subtitle?: string;
}

const { videoSrc, posterImage, title, subtitle } = Astro.props;
---

<section class="video-scrubber-hero">
  <video
    id="scrubber-video"
    class="hero-video"
    poster={posterImage}
    muted
    playsinline
  >
    <source src={videoSrc} type="video/mp4" />
    Your browser does not support the video tag.
  </video>

  <div class="hero-content">
    {title && <h1>{title}</h1>}
    {subtitle && <p>{subtitle}</p>}
    <slot />
  </div>

  <div class="scroll-indicator">
    <p>↓ Scroll to play ↓</p>
  </div>
</section>

<script>
  const video = document.getElementById('scrubber-video') as HTMLVideoElement;
  const heroSection = document.querySelector('.video-scrubber-hero') as HTMLElement;

  if (video && heroSection) {
    window.addEventListener('scroll', () => {
      // Get hero section position relative to viewport
      const rect = heroSection.getBoundingClientRect();
      const heroHeight = heroSection.offsetHeight;
      const windowHeight = window.innerHeight;

      // Calculate scroll progress through the hero (0 to 1)
      let scrollProgress = (windowHeight - rect.top) / (windowHeight + heroHeight);
      scrollProgress = Math.max(0, Math.min(1, scrollProgress));

      // Link video time to scroll progress
      video.currentTime = scrollProgress * video.duration;
    });
  }
</script>

<style>
  .video-scrubber-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: white;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    padding: 2rem;
  }

  .hero-content h1 {
    font-size: 3.5rem;
    margin: 0 0 1rem 0;
    font-weight: bold;
  }

  .hero-content p {
    font-size: 1.5rem;
    margin: 0 0 2rem 0;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    animation: bounce 2s infinite;
    color: white;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-10px);
    }
  }
</style>