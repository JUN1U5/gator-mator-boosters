---
import '../assets/styles.css';
import danceImage from '../assets/dance2026.jpg';
import vizImage from '../assets/viz-arts.jpg';
import danceImage2 from '../assets/dance2_2026.jpg';

---
<div class="container" id="about">
	<div class="feature-section">
<section class="feature-grid">
  <div class="feature-grid__item feature-grid__card">
      <h2 class="feature-grid__title">About Us</h2>
      <p>
       Green Level Visual Arts Dance Boosters Inc. is a registered 509(a)(2) public charity dedicated to supporting the arts at Green Level High School.
      </p>
	    <p>
        EIN: 42-3012438
      </p>
      <p>
        Location: 7600 Roberts Rd. Cary, NC 27519
      </p>
    </div>


<div class="feature-grid__item zoom-container">
    <img src={danceImage.src} alt="Dancers from the GLHS Dance Program" />
</div>

<div class="feature-grid__item zoom-container">
    <img src={vizImage.src} alt="GLHS student creating a mural in the hallways" />
</div>

<div class="feature-grid__item zoom-container">
	<img src={danceImage2.src} alt="Dancers from the GLHS Dance Program" />
</div>
</section>
</div>
</div>

<style>
.feature-section {
	width: 100%;
	border-top: 1px solid #e5e5e5;
	border-bottom: 1px solid #e5e5e5;
	background-color: white;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 64px 24px;
}

.feature-grid__item {
  min-height: 280px;
}

.feature-grid__item img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 280px;
  object-fit: cover;
  border-radius: 16px;
}

.feature-grid__card {
  background: #002E5D;
  color: #FFFDF7;
  border-radius: 16px;
  padding: 32px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.feature-grid__title {
  margin: 0 0 16px;
  font-size: 2rem;
  color: #FFFDF7 ;
}

.feature-grid__card p {
  margin: 0 0 16px;
  line-height: 1.6;
  color: #FFFDF7 ;
}

.feature-grid__card p:last-child {
  margin-bottom: 0;
}

@media (max-width: 768px) {
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-grid__item,
  .feature-grid__item img {
    min-height: 220px;
  }
}


.zoom-container {
  overflow: hidden;
  border-radius: 8px;
}

.zoom-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.zoom-container:hover img {
  transform: scale(1.1);
}

</style>
