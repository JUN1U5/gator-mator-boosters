---
import '../assets/styles.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title = "GLHS Visual Arts & Dance Boosters", 
  description = "Visual Arts & Dance Boosters at Green Level High School in Cary, NC. We aim to enrich students' visual arts & dance educational experience.",
  image = "https://glhsvad.org/_astro/horiz-logo.DPBmxj-P.png" 
} = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	
	    {/* Open Graph / Social Tags */}
    	<meta property="og:title" content={title} />
    	<meta property="og:description" content={description} />
    	<meta property="og:image" content={image} />

	</head>
	<body>
		<slot />
	</body>
</html>